[
  {
    "agent": "Claude Code",
    "file": "observatory/data/agents/claude-code.json",
    "mode": "auto",
    "who_decides": "another_model",
    "cells": [
      {
        "action": "read_files",
        "default": "allow",
        "scope": "working_directories",
        "capability": "cap-read-working-dirs",
        "url": "https://code.claude.com/docs/en/permissions",
        "all": [
          "cap-read-working-dirs: working_directories=allow",
          "cap-read-outside: outside_working_directories=ask"
        ]
      },
      {
        "action": "write_files",
        "default": "ask",
        "scope": "any_path",
        "capability": "cap-edit",
        "url": "https://code.claude.com/docs/en/permissions",
        "all": [
          "cap-edit: any_path=ask",
          "cap-protected-paths: protected_paths=ask"
        ]
      },
      {
        "action": "execute_commands",
        "default": "allow",
        "scope": "read_only_commands",
        "capability": "cap-readonly-commands",
        "url": "https://code.claude.com/docs/en/permissions",
        "all": [
          "cap-readonly-commands: read_only_commands=allow",
          "cap-commands: all_commands=ask"
        ]
      },
      {
        "action": "network",
        "default": "allow",
        "scope": "preapproved_domains",
        "capability": "cap-web-preapproved",
        "url": "https://code.claude.com/docs/en/permissions",
        "all": [
          "cap-web-preapproved: preapproved_domains=allow",
          "cap-web: any_destination=ask"
        ]
      },
      {
        "action": "use_mcp_tools",
        "default": null,
        "scope": null,
        "capability": null,
        "url": null
      }
    ]
  },
  {
    "agent": "Cursor",
    "file": "observatory/data/agents/cursor.json",
    "mode": "auto_review",
    "who_decides": "another_model",
    "cells": [
      {
        "action": "read_files",
        "default": "allow",
        "scope": "whole_system",
        "capability": "cap-sandbox-read",
        "url": "https://cursor.com/docs/reference/sandbox.md",
        "all": [
          "cap-read-workspace: working_directories=allow",
          "cap-read-outside: outside_working_directories=allow",
          "cap-read-ignored: ignored_credential_files=deny",
          "cap-sandbox-read: whole_system=allow"
        ]
      },
      {
        "action": "write_files",
        "default": "allow",
        "scope": "working_directories",
        "capability": "cap-write-workspace",
        "url": "https://cursor.com/docs/agent/security.md",
        "all": [
          "cap-write-workspace: working_directories=allow",
          "cap-sandbox-protected: protected_paths=deny"
        ]
      },
      {
        "action": "execute_commands",
        "default": "ask",
        "scope": "all_commands",
        "capability": "cap-terminal",
        "url": "https://cursor.com/docs/agent/security.md",
        "all": [
          "cap-terminal: all_commands=ask"
        ]
      },
      {
        "action": "network",
        "default": "ask",
        "scope": "any_destination",
        "capability": "cap-network",
        "url": "https://cursor.com/docs/agent/security.md",
        "all": [
          "cap-network: any_destination=ask"
        ]
      },
      {
        "action": "use_mcp_tools",
        "default": "ask",
        "scope": "all_mcp_tools",
        "capability": "cap-mcp",
        "url": "https://cursor.com/docs/context/mcp",
        "all": [
          "cap-mcp: all_mcp_tools=ask"
        ]
      }
    ]
  },
  {
    "agent": "Hermes Agent",
    "file": "observatory/data/agents/hermes-agent.json",
    "mode": "smart",
    "who_decides": "another_model",
    "cells": [
      {
        "action": "read_files",
        "default": "allow",
        "scope": "whole_system",

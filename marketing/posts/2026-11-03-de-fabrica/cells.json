        "all": [
          "cap-exec: all_commands=allow"
        ]
      },
      {
        "action": "network",
        "default": "allow",
        "scope": "any_destination",
        "capability": "cap-network",
        "url": "https://github.com/NousResearch/hermes-agent/blob/bf0203a794a07aac3ff764972ab9087baa4e4f4e/hermes_cli/config_defaults.py#L396-L401",
        "all": [
          "cap-network: any_destination=allow"
        ]
      },
      {
        "action": "use_mcp_tools",
        "default": "allow",
        "scope": "all_mcp_tools",
        "capability": "cap-mcp",
        "url": "https://github.com/NousResearch/hermes-agent/blob/bf0203a794a07aac3ff764972ab9087baa4e4f4e/tools/mcp_tool.py#L519-L533",
        "all": [
          "cap-mcp: all_mcp_tools=allow"
        ]
      }
    ]
  }

    {
      "source_url": "https://nvd.nist.gov/vuln/detail/CVE-2026-123493",
      "source_date": "2026-11-08",
      "subject": "Vikunja (MCP server)",
      "identifier": "CVE-2026-123493",
      "text": {
        "en": "CVE-2026-123493, published in NVD on 8 November 2026, affects Vikunja 2.4.0 before 2.7.1: disabled or locked users can keep access, including over MCP, through their bot users' API tokens.",
        "es": "CVE-2026-123493, publicado en NVD el 8 de noviembre de 2026, afecta a Vikunja desde 2.4.0 antes de 2.7.1: usuarios desactivados o bloqueados pueden mantener el acceso, también por MCP, con los tokens de API de sus usuarios bot.",
        "ca": "CVE-2026-123493, publicat a NVD el 8 de novembre de 2026, afecta Vikunja des de 2.4.0 abans de 2.7.1: usuaris desactivats o bloquejats poden mantenir l'accés, també per MCP, amb els tokens d'API dels seus usuaris bot."
      }
    },
    {
      "source_url": "https://changelog.qoder.cn/",
      "source_date": "2026-11-07",
      "subject": "Qoder CN",
      "identifier": null,
      "text": {
        "en": "Qoder CN 1.39.1, dated 7 November 2026, lets enterprise administrators turn off full access mode for members from the admin console, according to its changelog.",
        "es": "Qoder CN 1.39.1, del 7 de noviembre de 2026, permite a los administradores de empresa desactivar el modo de acceso completo de los miembros desde la consola de administración, según su changelog.",
        "ca": "Qoder CN 1.39.1, del 7 de novembre de 2026, permet als administradors d'empresa desactivar el mode d'accés complet dels membres des de la consola d'administració, segons el seu changelog."
      }
    },
    {
      "source_url": "https://github.com/QwenLM/qwen-code/releases/tag/v0.27.0",
      "source_date": "2026-11-07",
      "subject": "Qwen Code",
      "identifier": null,
      "text": {
        "en": "Qwen Code 0.27.0, dated 7 November 2026, adds repository allowlists and blocklists to the GitHub channel editor, according to its release notes.",
        "es": "Qwen Code 0.27.0, del 7 de noviembre de 2026, añade listas de repositorios permitidos y bloqueados al editor de canales de GitHub, según sus notas de versión.",
        "ca": "Qwen Code 0.27.0, del 7 de novembre de 2026, afegeix llistes de repositoris permesos i bloquejats a l'editor de canals de GitHub, segons les seves notes de versió."
      }
    }
  ],

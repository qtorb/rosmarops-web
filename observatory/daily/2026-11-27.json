  "items": [
    {
      "source_url": "https://changelog.qoder.cn/",
      "source_date": "2026-11-27",
      "subject": "Qoder CN",
      "identifier": null,
      "text": {
        "en": "Qoder CN IDE 1.42.0, dated 27 November 2026, adds mobile remote control to follow tasks, handle confirmation requests and stop tasks away from the computer, according to its changelog.",
        "es": "Qoder CN IDE 1.42.0, del 27 de noviembre de 2026, añade control remoto desde el móvil para seguir tareas, atender solicitudes de confirmación y detener tareas fuera del ordenador, según su changelog.",
        "ca": "Qoder CN IDE 1.42.0, del 27 de novembre de 2026, afegeix control remot des del mòbil per seguir tasques, atendre sol·licituds de confirmació i aturar tasques fora de l'ordinador, segons el seu changelog."
      }
    },
    {
      "source_url": "https://github.com/QwenLM/qwen-code/releases/tag/v0.28.7",
      "source_date": "2026-11-26",
      "subject": "Qwen Code",
      "identifier": null,
      "text": {
        "en": "Qwen Code v0.28.7, dated 26 November 2026, runs its CLI on the Harness kernel with usage statistics off unless privacy.usageStatisticsEnabled is true, according to its release notes.",
        "es": "Qwen Code v0.28.7, del 26 de noviembre de 2026, ejecuta su CLI sobre el kernel Harness con las estadísticas de uso desactivadas salvo que privacy.usageStatisticsEnabled sea true, según sus notas de versión.",
        "ca": "Qwen Code v0.28.7, del 26 de novembre de 2026, executa la seva CLI sobre el kernel Harness amb les estadístiques d'ús desactivades llevat que privacy.usageStatisticsEnabled sigui true, segons les seves notes de versió."
      }
    },
    {
      "source_url": "https://github.com/Kilo-Org/kilocode/releases/tag/v7.8.36",
      "source_date": "2026-11-26",
      "subject": "Kilo Code",
      "identifier": null,
      "text": {
        "en": "Kilo Code v7.8.36, dated 26 November 2026, shows control characters, bidi marks and invisible characters as literal escapes in the permission card, according to its release notes.",
        "es": "Kilo Code v7.8.36, del 26 de noviembre de 2026, muestra los caracteres de control, las marcas bidi y los caracteres invisibles como escapes literales en la tarjeta de permisos, según sus notas de versión.",
        "ca": "Kilo Code v7.8.36, del 26 de novembre de 2026, mostra els caràcters de control, les marques bidi i els caràcters invisibles com a escapaments literals a la targeta de permisos, segons les seves notes de versió."
      }
    },
    {
      "source_url": "https://osv.dev/vulnerability/MAL-2026-20659",
      "source_date": "2026-11-26",
      "subject": "tzero-mcp (npm)",
      "identifier": "MAL-2026-20659",
      "text": {
        "en": "MAL-2026-20659 (also MAL-0000-ghsa-malware-2912a06e08416131), in OSV on 26 November 2026, lists the npm package tzero-mcp as malicious code, according to OSV.",
        "es": "MAL-2026-20659 (también MAL-0000-ghsa-malware-2912a06e08416131), en OSV el 26 de noviembre de 2026, incluye el paquete de npm tzero-mcp como código malicioso, según OSV.",
        "ca": "MAL-2026-20659 (també MAL-0000-ghsa-malware-2912a06e08416131), a OSV el 26 de novembre de 2026, inclou el paquet de npm tzero-mcp com a codi maliciós, segons OSV."
      }
    },
    {
      "source_url": "https://nvd.nist.gov/vuln/detail/CVE-2026-131589",
      "source_date": "2026-11-26",
      "subject": "AI Engine (WordPress)",
      "identifier": "CVE-2026-131589",
      "text": {
        "en": "CVE-2026-131589, in NVD on 26 November 2026, affects the AI Engine MCP server plugin for WordPress up to 3.9.4 with a limited arbitrary file upload, according to NVD.",
        "es": "CVE-2026-131589, en NVD el 26 de noviembre de 2026, afecta al plugin de WordPress AI Engine, con servidor MCP, hasta 3.9.4 con una subida limitada de archivos arbitrarios, según NVD.",
        "ca": "CVE-2026-131589, a NVD el 26 de novembre de 2026, afecta el plugin de WordPress AI Engine, amb servidor MCP, fins a 3.9.4 amb una pujada limitada de fitxers arbitraris, segons NVD."
      }
    }
  ],
  "held": [
    {
      "text_en": "Orca v1.4.279, dated 27 November 2026, keeps custom Droid hook commands and recognizes existing hooks when refreshing, according to its release notes.",
      "source_url": "https://github.com/stablyai/orca/releases/tag/v1.4.279",

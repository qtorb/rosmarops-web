  "default_mode": {
    "name": "auto",
    "who_decides": "another_model",
    "since_version": "2.1.283",
    "note": {
      "en": "Built-in starting permission mode for interactive sessions; in auto mode a model, not the user, decides what would otherwise be asked.",
      "es": "Modo de permisos inicial integrado para las sesiones interactivas; en modo auto, lo que si no se preguntaría lo decide un modelo, no el usuario.",
      "ca": "Mode de permisos inicial integrat per a les sessions interactives; en mode auto, el que, si no, es preguntaria ho decideix un model, no l'usuari."
    },
    "source": {
      "url": "https://code.claude.com/docs/en/permission-modes",
      "official": true,
      "accessed_at": "2026-10-24"
    }
  },

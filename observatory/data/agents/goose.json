  "changes": [
    {
      "id": "chg-goose-1-61-0-mcp-headers",
      "version": "v1.61.0",
      "date": "2026-11-25",
      "category": "credentials",
      "before": {
        "en": "Before v1.61.0, the Goose release notes did not say that all headers in mcpServers configurations received over ACP are treated as secrets.",
        "es": "Antes de v1.61.0, las notas de versión de Goose no decían que todas las cabeceras de las configuraciones mcpServers recibidas por ACP se traten como secretos.",
        "ca": "Abans de v1.61.0, les notes de versió de Goose no deien que totes les capçaleres de les configuracions mcpServers rebudes per ACP es tractin com a secrets."
      },
      "after": {
        "en": "From v1.61.0, Goose handles every header in mcpServers configurations received over ACP as a secret, according to its release notes.",
        "es": "Desde v1.61.0, Goose trata como secreto cada cabecera de las configuraciones mcpServers recibidas por ACP, según sus notas de versión.",
        "ca": "Des de v1.61.0, Goose tracta com a secret cada capçalera de les configuracions mcpServers rebudes per ACP, segons les seves notes de versió."
      },
      "source": {
        "url": "https://github.com/aaif-goose/goose/releases/tag/v1.61.0",
        "official": true,
        "accessed_at": "2026-11-25"
      },
      "verified": {
        "by": "writer",
        "at": "2026-11-25",
        "how": "official_changelog"
      },
      "rosmarops_impact": "none"
    }

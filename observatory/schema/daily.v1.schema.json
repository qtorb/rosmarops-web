{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosmarops.com/observatory/schema/daily.v1.schema.json",
  "title": "RosmarOps Observatory daily synopsis (GTM-23)",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "reviewed_at", "status", "items", "checked", "held", "summary_ref"],
  "properties": {
    "date": {"$ref": "#/$defs/day"},
    "reviewed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "status": {"enum": ["published", "no_changes", "incomplete"]},
    "items": {"type": "array", "minItems": 0, "maxItems": 5, "items": {"$ref": "#/$defs/item"}},
    "checked": {"type": "array", "minItems": 0, "maxItems": 40, "items": {"$ref": "#/$defs/checked"}},
    "not_checked": {"type": "array", "maxItems": 40, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "held": {"type": "array", "items": {"$ref": "#/$defs/held"}},
    "summary_ref": {"type": "string", "pattern": "^docs/observatorio/\\d{4}-\\d{2}-\\d{2}\\.md$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "published"}}}, "then": {"properties": {"items": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "no_changes"}}}, "then": {"properties": {"items": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "incomplete"}}}, "then": {"required": ["not_checked"], "properties": {"not_checked": {"minItems": 1}}}},
    {"if": {"not": {"properties": {"status": {"const": "incomplete"}}}}, "then": {"properties": {"checked": {"minItems": 1}}}}
  ],
  "$defs": {
    "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date"},
    "https": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 500},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "source_date", "subject", "identifier", "text"],
      "properties": {
        "source_url": {"$ref": "#/$defs/https"},
        "source_date": {"$ref": "#/$defs/day"},
        "subject": {"type": "string", "minLength": 1, "maxLength": 60},
        "identifier": {
          "oneOf": [
            {"type": "string", "pattern": "^(MAL-\\d{4}-\\d+|GHSA(-[23456789cfghjmpqrvwx]{4}){3}|CVE-\\d{4}-\\d{4,})$"},
            {"type": "null"}
          ]
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "es", "ca"],
          "properties": {
            "en": {"type": "string", "minLength": 1, "maxLength": 400},
            "es": {"type": "string", "minLength": 1, "maxLength": 400},
            "ca": {"type": "string", "minLength": 1, "maxLength": 400}
          }
        }
      }
    },
    "checked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "latest_seen", "latest_date"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "url": {"$ref": "#/$defs/https"},
        "latest_seen": {"type": "string", "minLength": 0, "maxLength": 40},
        "latest_date": {"oneOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]}
      }
    },
    "held": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_en", "source_url", "rule", "reason"],
      "properties": {
        "text_en": {"type": "string"},
        "source_url": {"type": "string"},
        "rule": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 13}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}

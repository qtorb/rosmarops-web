              "enum": [
                "cmd",
                "none"
              ]
            },
            "cmd": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
            "status": {
              "enum": [
                "confirmed",
                "unconfirmed",
                "works_by_design",
                "before_also_fails",
                "not_documented"
              ]
            }
          }
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [

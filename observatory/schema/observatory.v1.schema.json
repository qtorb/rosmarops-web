{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosmarops.com/schemas/observatory.v1.schema.json",
  "title": "RosmarOps observatory, one agent file (v1.15: kinds gains orchestrator and workflow_automation; v1.14: optional templates.<system>.checks (read, network, notes, troubleshoot); v1.13: optional templates per system (kind, blocks, covers, uncovered, measure, source, watch, optional session); v1.12: protections gains read_only and asks_first (commands, optional edits); v1.11: optional protections (sandbox and network_cut per system); v1.10: capabilities[].default gains conflicting, with conflict; v1.9: who_decides gains unknown; v1.8: optional surfaces[] and reads_from[], agent.sources[] and agent.notes[], verified.how gains official_code; v1.7: kinds gains framework and personal_agent, who_decides gains rule, platforms gains python, optional agent.model; v1.6: capability scope other_agents_credentials; v1.5: change category agent_scope; v1.4: optional default_mode.basis and capabilities[].via; v1.3: prose fields are {en, es, ca} objects; v1.2: kinds gains agent_tooling; v1.1: optional default_mode, capabilities and storage)",
  "description": "One file per agent: data/observatory/agents/<id>.json. No user-facing prose beyond short technical sentences; every fact carries its source and date. Never data from users' machines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent",
    "versions",
    "changes",
    "ratings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "vendor",
        "kinds",
        "platforms",
        "local_footprint",
        "rosmarops",
        "reviewed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cli",
              "ide",
              "ide_extension",
              "desktop_app",
              "cloud",
              "agent_tooling",
              "framework",
              "personal_agent",
              "orchestrator",
              "workflow_automation"
            ]
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "web",
              "python"
            ]
          }
        },
        "local_footprint": {
          "enum": [
            "yes",
            "partial",
            "no"
          ]
        },
        "rosmarops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "evaluated",
                "detected",
                "not_supported"
              ]
            },
            "since_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "source"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        "sources": {
          "description": "v1.8 (GTM-106). The official source of a corrected agent field. A change to one of these fields needs an entry for it (checked in CI against the base commit).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "source",
              "verified"
            ],
            "properties": {
              "field": {
                "enum": [
                  "name",
                  "vendor",
                  "kinds",
                  "platforms",
                  "local_footprint"
                ]
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "verified": {
                "$ref": "#/$defs/verified"
              }
            }
          }
        },
        "notes": {
          "description": "v1.8 (GTM-106). Facts about the agent that no other field holds, as stable codes with their source. Not shown on the web until their texts are signed.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "source",
              "verified"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 60
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "verified": {
                "$ref": "#/$defs/verified"
              }
            }
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "released_at",
          "source"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "released_at": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "category",
          "before",
          "after",
          "source",
          "verified",
          "rosmarops_impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^chg-[a-z0-9-]{1,60}$"
          },
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "enum": [
              "permissions",
              "approval_mode",
              "sandbox",
              "default_value",
              "config_path_or_format",
              "mcp",
              "hooks",
              "instructions",
              "credentials",
              "telemetry",
              "data_destination",
              "agent_scope"
            ]
          },
          "before": {
            "$ref": "#/$defs/text"
          },
          "after": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "at",
              "how"
            ],
            "properties": {
              "by": {
                "enum": [
                  "advisor",
                  "writer"
                ]
              },
              "at": {
                "type": "string",
                "format": "date"
              },
              "how": {
                "enum": [
                  "official_doc",
                  "official_changelog",
                  "lab_observation",
                  "official_code"
                ]
              }
            }
          },
          "rosmarops_impact": {
            "enum": [
              "none",
              "knowledge",
              "rule"
            ]
          },
          "correction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "reason"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "ratings": {
      "description": "Agents Index measurements. Empty until method v1 and the lab exist.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "series",
          "method_version",
          "measured_at",
          "lab_run",
          "installer_sha256",
          "artifacts_sha256",
          "grade",
          "dimensions"
        ],
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "series": {
            "enum": [
              "factory",
              "hardened"
            ]
          },
          "method_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "measured_at": {
            "type": "string",
            "format": "date"
          },
          "lab_run": {
            "type": "string",
            "format": "uri"
          },
          "installer_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifacts_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "composite": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "read_without_asking",
              "execute_and_write",
              "who_approves",
              "network_and_mcp",
              "credentials",
              "cross_agent",
              "user_controls"
            ],
            "properties": {
              "read_without_asking": {
                "$ref": "#/$defs/band"
              },
              "execute_and_write": {
                "$ref": "#/$defs/band"
              },
              "who_approves": {
                "$ref": "#/$defs/band"
              },
              "network_and_mcp": {
                "$ref": "#/$defs/band"
              },
              "credentials": {
                "$ref": "#/$defs/band"
              },
              "cross_agent": {
                "$ref": "#/$defs/band"
              },
              "user_controls": {
                "$ref": "#/$defs/band"
              }
            }
          }
        }
      }
    },
    "default_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "who_decides",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,40}$"
        },
        "who_decides": {
          "enum": [
            "user",
            "another_model",
            "nobody",
            "rule",
            "unknown"
          ]
        },
        "since_version": {
          "type": "string",
          "maxLength": 40
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "basis": {
          "enum": [
            "documented_default",
            "documented_recommendation"
          ],
          "description": "documented_default: the docs state how the agent starts. documented_recommendation: the docs only recommend it and the mode in use cannot be read from disk (assumed). Absent means documented_default."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "scope",
          "default",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cap-[a-z0-9-]{1,60}$"
          },
          "action": {
            "enum": [
              "read_files",
              "write_files",
              "execute_commands",
              "network",
              "use_mcp_tools"
            ]
          },
          "scope": {
            "enum": [
              "working_directories",
              "outside_working_directories",
              "any_path",
              "whole_system",
              "protected_paths",
              "ignored_credential_files",
              "read_only_commands",
              "all_commands",
              "preapproved_domains",
              "any_destination",
              "all_mcp_tools",
              "other_agents_credentials"
            ]
          },
          "default": {
            "enum": [
              "allow",
              "ask",
              "deny",
              "conflicting"
            ]
          },
          "note": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "via": {
            "enum": [
              "tools",
              "shell",
              "sandboxed_shell"
            ],
            "description": "How the agent does it: its own tools, its shell, or its shell inside the sandbox. Optional."
          },
          "conflict": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "sources"
            ],
            "description": "v1.10 (GTM-165): the vendor's own sources contradict each other (rule f). The page shows «—», this text and both sources with their quotes.",
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "sources": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "quote"
                  ],
                  "properties": {
                    "source": {
                      "$ref": "#/$defs/source"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "default": {
                  "const": "conflicting"
                }
              }
            },
            "then": {
              "required": [
                "conflict"
              ]
            }
          }
        ]
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path_windows",
          "secrets",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sto-[a-z0-9-]{1,60}$"
          },
          "kind": {
            "enum": [
              "user_settings",
              "project_settings",
              "local_settings",
              "managed_settings",
              "mcp_user",
              "mcp_project",
              "mcp_managed",
              "permissions",
              "sandbox",
              "cli_config",
              "hooks_managed",
              "instructions",
              "account_credentials"
            ]
          },
          "path_windows": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "secrets": {
            "enum": [
              "none",
              "sometimes_plaintext",
              "plaintext",
              "unknown"
            ]
          },
          "note": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "surfaces": {
      "description": "v1.8 (GTM-105). Surfaces the agent has, each with its official source. A surface without an entry is «not verified», never «absent». One entry per surface (checked in CI).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "since",
          "since_basis",
          "source",
          "verified"
        ],
        "properties": {
          "surface": {
            "enum": [
              "mcp",
              "hooks",
              "skills",
              "plugins",
              "subagents",
              "rules_files",
              "browser",
              "computer_use",
              "scheduled_tasks",
              "cloud_execution",
              "permission_modes"
            ]
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "since_basis": {
            "enum": [
              "announced",
              "first_mention",
              null
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "verified": {
            "$ref": "#/$defs/verified"
          }
        }
      }
    },
    "reads_from": {
      "description": "v1.8 (GTM-105). Files of another agent, or of a shared convention, that this agent reads or loads. owner: an agent file id or «shared» (checked against observatory/data/shared-files.json in CI). condition: a code, not prose. v1.9 (GTM-108): default_source, optional: the official source that shows the default value when `source` (the line or page with the literal path) does not.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "owner",
          "load",
          "source",
          "verified"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "owner": {
            "type": "string",
            "pattern": "^(shared|[a-z0-9][a-z0-9-]{1,40})$"
          },
          "load": {
            "enum": [
              "default",
              "if_trusted",
              "if_configured",
              "on_import"
            ]
          },
          "condition": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 60
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "verified": {
            "$ref": "#/$defs/verified"
          },
          "default_source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "protections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox",
        "network_cut"
      ],
      "description": "v1.11 (GTM-167, signed by Albert 15-11): sandbox and network cut-off per system, as codes with their source, from GTM-164 v2. v1.12 (GTM-169, signed by Albert 15-11 16:03): read_only and asks_first (commands; edits only where GTM-164 v2 gives a second line).",
      "properties": {
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windows",
            "macos",
            "linux"
          ],
          "properties": {
            "windows": {
              "$ref": "#/$defs/protection_cell"
            },
            "macos": {
              "$ref": "#/$defs/protection_cell"
            },
            "linux": {
              "$ref": "#/$defs/protection_cell"
            }
          }
        },
        "network_cut": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windows",
            "macos",
            "linux"
          ],
          "properties": {
            "windows": {
              "$ref": "#/$defs/protection_cell"
            },
            "macos": {
              "$ref": "#/$defs/protection_cell"
            },
            "linux": {
              "$ref": "#/$defs/protection_cell"
            }
          }
        },
        "read_only": {
          "$ref": "#/$defs/read_only_cell"
        },
        "asks_first": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commands"
          ],
          "properties": {
            "commands": {
              "$ref": "#/$defs/asks_first_cell"
            },
            "edits": {
              "$ref": "#/$defs/asks_first_cell"
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows",
        "macos",
        "linux"
      ],
      "description": "v1.13 (GTM-175, signed by Albert 16-11): the sandbox template of each system, shown on /sandbox/.",
      "properties": {
        "windows": {
          "$ref": "#/$defs/template"
        },
        "macos": {
          "$ref": "#/$defs/template"
        },
        "linux": {
          "$ref": "#/$defs/template"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "official",
        "accessed_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "official": {
          "type": "boolean"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "band": {
      "enum": [
        "restricted",
        "contained",
        "partial",
        "broad",
        "open",
        "not_observed"
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "ca": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      },
      "description": "Short prose. EN is the source; ES and CA are translations signed by Albert. A page is published only when every text on it has all three."
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "at",
        "how"
      ],
      "properties": {
        "by": {
          "enum": [
            "advisor",
            "writer"
          ]
        },
        "at": {
          "type": "string",
          "format": "date"
        },
        "how": {
          "enum": [
            "official_doc",
            "official_changelog",
            "official_code"
          ]
        }
      }
    },
    "protection_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "enum": [
            "on_by_default",
            "off_by_default",
            "container_only",
            "none",
            "unknown"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "source"
              ]
            }
          },
          "else": {
            "required": [
              "source"
            ]
          }
        }
      ],
      "description": "One protection on one system (GTM-167): its value, with the source it comes from; unknown has no source and shows «—»."
    },
    "read_only_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "source"
              ]
            }
          },
          "else": {
            "required": [
              "source"
            ]
          }
        }
      ],
      "description": "Read-only mode (GTM-169): yes, no or unknown; unknown has no source and shows «—»."
    },
    "asks_first_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "enum": [
            "by_default",
            "if_configured",
            "another_model",
            "no",
            "unknown"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "source"
              ]
            }
          },
          "else": {
            "required": [
              "source"
            ]
          }
        }
      ],
      "description": "Asks you first (GTM-169): who approves by default; unknown has no source and shows «—» (rule f: contradiction → unknown)."
    },
    "template_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "official",
        "accessed_at",
        "page_date"
      ],
      "description": "v1.13 (GTM-175): an official page a template rests on; watch: literal strings that must stay in it (sources.json page-watch).",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "official": {
          "type": "boolean"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "page_date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "watch": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "blocks",
        "covers",
        "uncovered",
        "measure",
        "source",
        "watch"
      ],
      "description": "v1.13 (GTM-175, CTO-58 §5.4 signed by Albert): the template of one system. Values from CTO-58 §1 with CTO-59, CTO-60 and GTM-175 §1-§6.",
      "properties": {
        "kind": {
          "enum": [
            "agent_sandbox",
            "container",
            "separate_account"
          ]
        },
        "intro": {
          "enum": [
            "paste_one",
            "paste_many",
            "vscode_settings"
          ],
          "description": "Which signed sentence goes before the blocks (GTM-175 §2.2 and §3)."
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "format",
              "value"
            ],
            "properties": {
              "file": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 80
              },
              "format": {
                "enum": [
                  "json",
                  "toml",
                  "yaml",
                  "ui",
                  "env"
                ]
              },
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "description": "The literal block; for ui, the code of its signed step."
              },
              "note": {
                "enum": [
                  "gemini_macos"
                ],
                "description": "env only: the code of the sentence that goes before it."
              }
            }
          }
        },
        "covers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sandbox",
            "read_limit",
            "network_cut"

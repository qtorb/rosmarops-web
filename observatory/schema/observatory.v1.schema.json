{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosmarops.com/schemas/observatory.v1.schema.json",
  "title": "RosmarOps observatory, one agent file (v1.6: capability scope other_agents_credentials; v1.5: change category agent_scope; v1.4: optional default_mode.basis and capabilities[].via; v1.3: prose fields are {en, es, ca} objects; v1.2: kinds gains agent_tooling; v1.1: optional default_mode, capabilities and storage)",
  "description": "One file per agent: data/observatory/agents/<id>.json. No user-facing prose beyond short technical sentences; every fact carries its source and date. Never data from users' machines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent",
    "versions",
    "changes",
    "ratings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "vendor",
        "kinds",
        "platforms",
        "local_footprint",
        "rosmarops",
        "reviewed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cli",
              "ide",
              "ide_extension",
              "desktop_app",
              "cloud",
              "agent_tooling"
            ]
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "web"
            ]
          }
        },
        "local_footprint": {
          "enum": [
            "yes",
            "partial",
            "no"
          ]
        },
        "rosmarops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "evaluated",
                "detected",
                "not_supported"
              ]
            },
            "since_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "released_at",
          "source"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "released_at": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "category",
          "before",
          "after",
          "source",
          "verified",
          "rosmarops_impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^chg-[a-z0-9-]{1,60}$"
          },
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "enum": [
              "permissions",
              "approval_mode",
              "sandbox",
              "default_value",
              "config_path_or_format",
              "mcp",
              "hooks",
              "instructions",
              "credentials",
              "telemetry",
              "data_destination",
              "agent_scope"
            ]
          },
          "before": {
            "$ref": "#/$defs/text"
          },
          "after": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "at",
              "how"
            ],
            "properties": {
              "by": {
                "enum": [
                  "advisor"
                ]
              },
              "at": {
                "type": "string",
                "format": "date"
              },
              "how": {
                "enum": [
                  "official_doc",
                  "official_changelog",
                  "lab_observation"
                ]
              }
            }
          },
          "rosmarops_impact": {
            "enum": [
              "none",
              "knowledge",
              "rule"
            ]
          },
          "correction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "reason"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "ratings": {
      "description": "Agents Index measurements. Empty until method v1 and the lab exist.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "series",
          "method_version",
          "measured_at",
          "lab_run",
          "installer_sha256",
          "artifacts_sha256",
          "grade",
          "dimensions"
        ],
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "series": {
            "enum": [
              "factory",
              "hardened"
            ]
          },
          "method_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "measured_at": {
            "type": "string",
            "format": "date"
          },
          "lab_run": {
            "type": "string",
            "format": "uri"
          },
          "installer_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifacts_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "composite": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "read_without_asking",
              "execute_and_write",
              "who_approves",
              "network_and_mcp",
              "credentials",
              "cross_agent",
              "user_controls"
            ],
            "properties": {
              "read_without_asking": {
                "$ref": "#/$defs/band"
              },
              "execute_and_write": {
                "$ref": "#/$defs/band"
              },
              "who_approves": {
                "$ref": "#/$defs/band"
              },
              "network_and_mcp": {
                "$ref": "#/$defs/band"
              },
              "credentials": {
                "$ref": "#/$defs/band"
              },
              "cross_agent": {
                "$ref": "#/$defs/band"
              },
              "user_controls": {
                "$ref": "#/$defs/band"
              }
            }
          }
        }
      }
    },
    "default_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "who_decides",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,40}$"
        },
        "who_decides": {
          "enum": [
            "user",
            "another_model",
            "nobody"
          ]
        },
        "since_version": {
          "type": "string",
          "maxLength": 40
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "basis": {
          "enum": [
            "documented_default",
            "documented_recommendation"
          ],
          "description": "documented_default: the docs state how the agent starts. documented_recommendation: the docs only recommend it and the mode in use cannot be read from disk (assumed). Absent means documented_default."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "scope",
          "default",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cap-[a-z0-9-]{1,60}$"
          },
          "action": {
            "enum": [
              "read_files",
              "write_files",
              "execute_commands",
              "network",
              "use_mcp_tools"
            ]
          },
          "scope": {
            "enum": [
              "working_directories",
              "outside_working_directories",
              "any_path",
              "whole_system",
              "protected_paths",
              "ignored_credential_files",
              "read_only_commands",
              "all_commands",
              "preapproved_domains",
              "any_destination",
              "all_mcp_tools",
              "other_agents_credentials"
            ]
          },
          "default": {
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          },
          "note": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "via": {
            "enum": [
              "tools",
              "shell",
              "sandboxed_shell"
            ],
            "description": "How the agent does it: its own tools, its shell, or its shell inside the sandbox. Optional."
          }
        }
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path_windows",
          "secrets",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sto-[a-z0-9-]{1,60}$"
          },
          "kind": {
            "enum": [
              "user_settings",
              "project_settings",
              "local_settings",
              "managed_settings",
              "mcp_user",
              "mcp_project",
              "mcp_managed",
              "permissions",
              "sandbox",
              "cli_config",
              "hooks_managed",
              "instructions",
              "account_credentials"
            ]
          },
          "path_windows": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "secrets": {
            "enum": [
              "none",
              "sometimes_plaintext",
              "plaintext",
              "unknown"
            ]
          },
          "note": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "official",
        "accessed_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "official": {
          "type": "boolean"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "band": {
      "enum": [
        "restricted",
        "contained",
        "partial",
        "broad",
        "open",
        "not_observed"
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "ca": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      },
      "description": "Short prose. EN is the source; ES and CA are translations signed by Albert. A page is published only when every text on it has all three."
    }
  }
}

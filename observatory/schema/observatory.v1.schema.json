            }
          }
        },
        "checks": {
          "$ref": "#/$defs/template_check"
        }
      }
    },
    "template_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "network",
        "notes",
        "troubleshoot"
      ],
      "description": "v1.14 (GTM-176 §1, values from CTO-61 §1 and §2): the before/after test of the step-by-step guide.",
      "properties": {
        "read": {
          "type": "object",
          "additionalProperties": false,

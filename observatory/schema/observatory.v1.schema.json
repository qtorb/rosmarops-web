{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosmarops.com/schemas/observatory.v1.schema.json",
  "title": "RosmarOps observatory, one agent file (v1)",
  "description": "One file per agent: data/observatory/agents/<id>.json. No user-facing prose beyond short technical sentences; every fact carries its source and date. Never data from users' machines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent", "versions", "changes", "ratings"],
  "properties": {
    "schema_version": { "const": 1 },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "vendor", "kinds", "platforms", "local_footprint", "rosmarops", "reviewed_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 60 },
        "kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["cli", "ide", "ide_extension", "desktop_app", "cloud"] } },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "macos", "linux", "web"] } },
        "local_footprint": { "enum": ["yes", "partial", "no"] },
        "rosmarops": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["evaluated", "detected", "not_supported"] },
            "since_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
          }
        },
        "reviewed_at": { "type": "string", "format": "date" }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "released_at", "source"],
        "properties": {
          "version": { "type": "string", "minLength": 1, "maxLength": 40 },
          "released_at": { "type": "string", "format": "date" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "category", "before", "after", "source", "verified", "rosmarops_impact"],
        "properties": {
          "id": { "type": "string", "pattern": "^chg-[a-z0-9-]{1,60}$" },
          "version": { "type": "string", "maxLength": 40 },
          "date": { "type": "string", "format": "date" },
          "category": { "enum": ["permissions", "approval_mode", "sandbox", "default_value", "config_path_or_format", "mcp", "hooks", "instructions", "credentials", "telemetry", "data_destination"] },
          "before": { "type": "string", "minLength": 1, "maxLength": 280 },
          "after": { "type": "string", "minLength": 1, "maxLength": 280 },
          "source": { "$ref": "#/$defs/source" },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "at", "how"],
            "properties": {
              "by": { "enum": ["advisor"] },
              "at": { "type": "string", "format": "date" },
              "how": { "enum": ["official_doc", "official_changelog", "lab_observation"] }
            }
          },
          "rosmarops_impact": { "enum": ["none", "knowledge", "rule"] },
          "correction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "reason"],
            "properties": {
              "at": { "type": "string", "format": "date" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 280 }
            }
          }
        }
      }
    },
    "ratings": {
      "description": "Agents Index measurements. Empty until method v1 and the lab exist.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "series", "method_version", "measured_at", "lab_run", "installer_sha256", "artifacts_sha256", "grade", "dimensions"],
        "properties": {
          "version": { "type": "string", "maxLength": 40 },
          "series": { "enum": ["factory", "hardened"] },
          "method_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "measured_at": { "type": "string", "format": "date" },
          "lab_run": { "type": "string", "format": "uri" },
          "installer_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifacts_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "grade": { "enum": ["A", "B", "C", "D", "E"] },
          "composite": { "type": "number", "minimum": 0, "maximum": 100 },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["read_without_asking", "execute_and_write", "who_approves", "network_and_mcp", "credentials", "cross_agent", "user_controls"],
            "properties": {
              "read_without_asking": { "$ref": "#/$defs/band" },
              "execute_and_write": { "$ref": "#/$defs/band" },
              "who_approves": { "$ref": "#/$defs/band" },
              "network_and_mcp": { "$ref": "#/$defs/band" },
              "credentials": { "$ref": "#/$defs/band" },
              "cross_agent": { "$ref": "#/$defs/band" },
              "user_controls": { "$ref": "#/$defs/band" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "official", "accessed_at"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "official": { "type": "boolean" },
        "accessed_at": { "type": "string", "format": "date" }
      }
    },
    "band": { "enum": ["restricted", "contained", "partial", "broad", "open", "not_observed"] }
  }
}

          "properties": {
            "sandbox": {
              "type": "boolean"
            },
            "read_limit": {
              "enum": [
                "workspace",
                "listed_paths",
                "none",
                "unknown"
              ]
            },
            "network_cut": {
              "enum": [
                "yes",
                "allowlist",
                "no",
                "unknown"
              ]
            }
          }
        },
        "uncovered": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "allowed_outside_full_privileges",
              "allowlist_and_fetch_outside_sandbox",
              "allowlisted_destinations_open",
              "apps_connectors_outside_sandbox",
              "bang_prompt_outside_sandbox",
              "browser_computer_use_outside_sandbox",
              "builtin_tools_own_checks",
              "container_may_be_older",
              "deny_read_fixed_at_start",
              "excluded_commands_outside_sandbox",
              "file_and_web_tools_outside_sandbox",
              "git_credentials_injected",
              "home_read_undocumented",
              "hooks_mcp_statusline_outside_sandbox",
              "linux_needs_landlock_v3",
              "macos_proxy_undocumented",
              "mcp_fetch_hooks_undocumented",
              "mcp_not_launched_by_editor",
              "mcp_on_host",
              "mcp_outside_sandbox",
              "mcp_read_url_by_rules",
              "model_api_web_tools_not_blocked",
              "needs_docker",
              "network_cut_noop_macos",
              "no_effect_without_system_sandbox",
              "other_agents_config_in_project",
              "service_traffic_outside_sandbox",
              "web_search_needs_launch_flag",
              "web_search_outside_sandbox",
              "windows_outside_profile_readable",
              "windows_read_network_undocumented"
            ]
          }
        },
        "measure": {
          "enum": [
            "measured",
            "guided"
          ]
        },
        "source": {
          "$ref": "#/$defs/template_source"
        },
        "extra_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/template_source"
          }
        },
        "watch": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "requires",
            "source"
          ],
          "description": "GTM-175: the one-session command of CTO-60, only for Claude Code (macOS, Linux), Codex, Grok Build (macOS, Linux) and Antigravity CLI (macOS, Linux).",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "requires": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "bubblewrap_socat",
                  "linux_5_13",
                  "windows_11_24h2_25h2"
                ]
              }
            },

{
  "$comment": "GTM-75. Single list of the Observatory's fixed sources F1-F28, read daily by observatory/collect.py. Methods and URLs transcribed from rosmarops-vigil docs/research/2026-11-01-observatorio-ampliacion-fuentes.md (signed 01-11) and docs/observatorio/fuentes-F1-F28.md (annex to GTM-75). public_url: the url of each source in 'checked' of observatory/daily/2026-11-03.json (commit aa5f165); Hermes Agent's from the annex. scope: the agent file in observatory/data/agents/ the source watches, 'threats' for the threat registries, 'all-agents' for cross-cutting sources. Tag patterns: 'v*' means v followed by a version number (likewise 'rust-v*', 'python-*', 'python-v*'); 'N.N.N' means three numbers without a prefix; null means every tag. Tags with alpha, beta, rc, nightly, preview, canary or dev are discarded; the rest are ordered like sort -V. read.notes is the order in which notes are looked for: 'github-api' (body of the GitHub release with that tag, read with the workflow's token; GTM-76), 'raw' (official CHANGELOG on raw.githubusercontent.com), 'web' (official changelog page), 'tag' (annotated tag text); an empty list means the source needs no notes.",
  "scope_terms": [
    "mcp",
    "agent",
    "skill",
    "claude",
    "anthropic",
    "codex",
    "openai",
    "cursor",
    "copilot",
    "cline",
    "gemini",
    "antigravity",
    "hermes",
    "opencode",
    "kiro",
    "devin",
    "goose",
    "openclaw",
    "langgraph",
    "crewai",
    "autogen"
  ],
  "sources": [
    {
      "id": "F1",
      "name": "Claude Code",
      "scope": "claude-code",
      "method": "changelog-web",
      "read": {
        "urls": [
          "https://code.claude.com/docs/en/changelog"
        ],
        "fallback": {
          "git": "https://github.com/anthropics/claude-code.git",
          "tags": null,
          "notes": []
        }
      },
      "public_url": "https://code.claude.com/docs/en/changelog",
      "fragile": false,
      "notes": "If the changelog page fails: tags of the git repository; a new version without notes is NOT opened."
    },
    {

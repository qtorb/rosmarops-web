  "default_mode": {
    "name": "auto",
    "who_decides": "another_model",
    "since_version": "2.1.283",
    "note": "Built-in starting permission mode for interactive sessions; in auto mode a model, not the user, decides what would otherwise be asked.",
    "source": {
      "url": "https://code.claude.com/docs/en/permission-modes",
      "official": true,
      "accessed_at": "2026-10-24"
    }
  },

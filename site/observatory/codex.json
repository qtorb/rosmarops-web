{
  "schema_version": 1,
  "agent": {
    "id": "codex",
    "name": "Codex",
    "vendor": "OpenAI",
    "kinds": [
      "cli",
      "ide_extension",
      "desktop_app",
      "cloud"
    ],
    "platforms": [
      "windows",
      "macos",
      "linux",
      "web"
    ],
    "local_footprint": "yes",
    "rosmarops": {
      "status": "evaluated",
      "since_version": "0.8.0"
    },
    "reviewed_at": "2026-11-10"
  },
  "versions": [],
  "changes": [],
  "ratings": [],
  "default_mode": {
    "name": "on_request",
    "who_decides": "user",
    "source": {
      "url": "https://github.com/openai/codex/blob/67f0994/codex-rs/protocol/src/protocol.rs#L1154-L1156",
      "official": true,
      "accessed_at": "2026-11-01"
    },
    "note": {
      "en": "Starts in the Auto preset: it works inside the project without asking and asks you before going further.",
      "es": "Empieza en el modo Auto: trabaja dentro del proyecto sin preguntar y te pregunta antes de ir más allá.",
      "ca": "Comença en el mode Auto: treballa dins del projecte sense preguntar i et pregunta abans d'anar més enllà."
    },
    "basis": "documented_default"
  },
  "capabilities": [
    {
      "id": "cap-read-any",
      "action": "read_files",
      "scope": "any_path",
      "default": "allow",
      "source": {
        "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
        "official": true,
        "accessed_at": "2026-11-01"
      },
      "note": {
        "en": "It reads every file your user account can read, not only the project.",
        "es": "Lee todos los ficheros que puede leer tu usuario, no solo los del proyecto.",
        "ca": "Llegeix tots els fitxers que pot llegir el teu usuari, no només els del projecte."
      },
      "via": "tools"
    },
    {
      "id": "cap-write-working",
      "action": "write_files",
      "scope": "working_directories",
      "default": "allow",
      "source": {
        "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
        "official": true,
        "accessed_at": "2026-11-01"
      }
    },
    {
      "id": "cap-write-outside",
      "action": "write_files",
      "scope": "outside_working_directories",
      "default": "ask",
      "source": {
        "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
        "official": true,
        "accessed_at": "2026-11-01"
      }
    },
    {
      "id": "cap-write-protected",
      "action": "write_files",
      "scope": "protected_paths",
      "default": "ask",
      "source": {
        "url": "https://github.com/openai/codex/blob/67f0994/codex-rs/protocol/src/permissions.rs#L40-L43",
        "official": true,
        "accessed_at": "2026-11-01"
      }
    },
    {
      "id": "cap-shell-sandbox",
      "action": "execute_commands",
      "scope": "all_commands",
      "default": "allow",
      "via": "sandboxed_shell",
      "source": {
        "url": "https://github.com/openai/codex/blob/67f0994/codex-rs/protocol/src/protocol.rs#L1154-L1156",
        "official": true,
        "accessed_at": "2026-11-01"
      }
    },
    {
      "id": "cap-network",
      "action": "network",
      "scope": "any_destination",
      "default": "ask",
      "source": {
        "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
        "official": true,
        "accessed_at": "2026-11-01"
      }
    }
  ],
  "protections": {
    "sandbox": {
      "windows": {
        "value": "on_by_default",
        "source": {
          "url": "https://learn.chatgpt.com/docs/windows/windows-sandbox",
          "official": true,
          "accessed_at": "2026-11-15"
        }
      },
      "macos": {
        "value": "on_by_default",
        "source": {
          "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
          "official": true,
          "accessed_at": "2026-11-15"
        }
      },
      "linux": {
        "value": "on_by_default",
        "source": {
          "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
          "official": true,
          "accessed_at": "2026-11-15"
        }
      }
    },
    "network_cut": {
      "windows": {
        "value": "on_by_default",
        "source": {
          "url": "https://learn.chatgpt.com/docs/windows/windows-sandbox",
          "official": true,
          "accessed_at": "2026-11-15"
        }
      },
      "macos": {
        "value": "on_by_default",
        "source": {
          "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
          "official": true,
          "accessed_at": "2026-11-15"
        }
      },
      "linux": {
        "value": "on_by_default",
        "source": {
          "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
          "official": true,
          "accessed_at": "2026-11-15"
        }
      }
    },
    "read_only": {
      "value": "yes",
      "source": {
        "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
        "official": true,
        "accessed_at": "2026-11-15"
      }
    },
    "asks_first": {
      "commands": {
        "value": "no",
        "source": {
          "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
          "official": true,
          "accessed_at": "2026-11-15"
        }
      }
    }
  },
  "templates": {
    "windows": {
      "kind": "agent_sandbox",
      "intro": "paste_one",
      "blocks": [
        {
          "file": "~/.codex/config.toml",
          "format": "toml",
          "value": "default_permissions = \"p2\"\n[permissions.p2.filesystem]\n\":minimal\" = \"read\"\n[permissions.p2.filesystem.\":workspace_roots\"]\n\".\" = \"write\"\n\"**/*.env\" = \"deny\"\n[permissions.p2.network]\nenabled = false\n[windows]\nsandbox = \"mxc\""
        }
      ],
      "covers": {
        "sandbox": true,
        "read_limit": "workspace",
        "network_cut": "yes"
      },
      "uncovered": [
        "web_search_outside_sandbox",
        "apps_connectors_outside_sandbox",
        "mcp_outside_sandbox",
        "browser_computer_use_outside_sandbox",
        "service_traffic_outside_sandbox",
        "deny_read_fixed_at_start"
      ],
      "measure": "guided",
      "source": {
        "url": "https://learn.chatgpt.com/docs/permissions",
        "official": true,
        "accessed_at": "2026-11-16",
        "page_date": null
      },
      "watch": [
        "default_permissions",
        ":workspace_roots",
        ":minimal",
        "Permission profiles do not compose with the older sandbox settings",
        "Matching files created afterward are not added to that process's deny list"
      ],
      "extra_sources": [
        {
          "url": "https://learn.chatgpt.com/docs/agent-approvals-security",
          "official": true,
          "accessed_at": "2026-11-16",
          "page_date": null,
          "watch": [
            "workspace-write",
            "keeps network access turned off unless you enable it",
            "It does not filter web search",
            "app or connector tool calls",
            "MCP server connections",
            "browser or Computer Use activity"
          ]
        },
        {
          "url": "https://learn.chatgpt.com/codex/windows/windows-sandbox.md",
          "official": true,
          "accessed_at": "2026-11-16",
          "page_date": null,
          "watch": [
            "mxc",
            "doesn't support denied read paths",
            "24H2",
            "25H2",
            "for one command without changing the saved sandbox selection"
          ]
        }
      ],
      "session": {
        "command": "codex --sandbox workspace-write -c sandbox_workspace_write.network_access=false -c windows.sandbox=mxc",
        "requires": [
          "windows_11_24h2_25h2"
        ],
        "source": {
          "url": "https://learn.chatgpt.com/codex/windows/windows-sandbox.md",
          "official": true,
          "accessed_at": "2026-11-16",
          "page_date": null
        }
      },
      "checks": {
        "read": {
          "kind": "cmd",
          "cmd": "dir ~",
          "status": "unconfirmed"
        },
        "network": {
          "kind": "cmd",
          "cmd": "curl -I https://example.com",
          "status": "before_also_fails"
        },
        "notes": [],
        "troubleshoot": [
          "codex_sandbox_mode",
          "codex_status",
          "codex_windows"
        ]
      }
    },

{
  "schema_version": 1,
  "agent": {
    "id": "cursor",
    "name": "Cursor",
    "vendor": "Anysphere",
    "kinds": [
      "ide"
    ],
    "platforms": [
      "windows",
      "macos",
      "linux"
    ],
    "local_footprint": "yes",
    "rosmarops": {
      "status": "evaluated",
      "since_version": "0.1.0"
    },
    "reviewed_at": "2026-10-28"
  },
  "versions": [],
  "changes": [],
  "ratings": [],
  "default_mode": {
    "name": "auto_review",
    "who_decides": "another_model",
    "note": {
      "en": "Documented as the recommended default since Cursor 3.6; the mode in use is not readable from disk, so this is assumed.",
      "es": "Documentado como el valor por defecto recomendado desde Cursor 3.6; el modo en uso no se puede leer del disco, así que es una suposición.",
      "ca": "Documentat com el valor per defecte recomanat des de Cursor 3.6; el mode en ús no es pot llegir del disc, així que és una suposició."
    },
    "source": {
      "url": "https://cursor.com/docs/agent/security/run-modes.md",
      "official": true,
      "accessed_at": "2026-10-25"
    },
    "basis": "documented_recommendation"
  },
  "capabilities": [
    {
      "id": "cap-read-workspace",
      "action": "read_files",
      "scope": "working_directories",
      "default": "allow",
      "source": {
        "url": "https://cursor.com/docs/agent/security.md",
        "official": true,
        "accessed_at": "2026-10-25"
      }
    },
    {
      "id": "cap-read-ignored",
      "action": "read_files",
      "scope": "ignored_credential_files",
      "default": "deny",
      "note": {
        "en": "Default ignore patterns that cover credential files, for the file tools only.",
        "es": "Patrones de exclusión por defecto que cubren ficheros de credenciales, solo para las herramientas de ficheros.",
        "ca": "Patrons d'exclusió per defecte que cobreixen fitxers de credencials, només per a les eines de fitxers."
      },
      "source": {
        "url": "https://cursor.com/docs/reference/ignore-file",
        "official": true,
        "accessed_at": "2026-10-25"
      }
    },
    {
      "id": "cap-sandbox-read",
      "action": "read_files",
      "scope": "whole_system",
      "default": "allow",
      "note": {
        "en": "The sandboxed shell's read boundary defaults to the whole system.",
        "es": "El límite de lectura del shell en sandbox es, por defecto, todo el sistema.",
        "ca": "El límit de lectura del shell en sandbox és, per defecte, tot el sistema."
      },
      "source": {
        "url": "https://cursor.com/docs/reference/sandbox.md",
        "official": true,
        "accessed_at": "2026-10-25"
      },
      "via": "sandboxed_shell"
    },
    {
      "id": "cap-write-workspace",
      "action": "write_files",
      "scope": "working_directories",
      "default": "allow",
      "note": {
        "en": "Except configuration files.",
        "es": "Salvo los ficheros de configuración.",
        "ca": "Excepte els fitxers de configuració."
      },
      "source": {
        "url": "https://cursor.com/docs/agent/security.md",
        "official": true,
        "accessed_at": "2026-10-25"
      }
    },
    {
      "id": "cap-sandbox-protected",
      "action": "write_files",
      "scope": "protected_paths",
      "default": "deny",
      "source": {
        "url": "https://cursor.com/docs/reference/sandbox.md",
        "official": true,
        "accessed_at": "2026-10-25"
      }
    },
    {
      "id": "cap-terminal",
      "action": "execute_commands",
      "scope": "all_commands",
      "default": "ask",
      "source": {
        "url": "https://cursor.com/docs/agent/security.md",
        "official": true,
        "accessed_at": "2026-10-25"
      }
    },
    {
      "id": "cap-mcp",
      "action": "use_mcp_tools",
      "scope": "all_mcp_tools",
      "default": "ask",
      "source": {
        "url": "https://cursor.com/docs/context/mcp",
        "official": true,
        "accessed_at": "2026-10-25"
      }
    },
    {
      "id": "cap-network",
      "action": "network",
      "scope": "any_destination",
      "default": "ask",
      "note": {
        "en": "With documented exceptions.",
        "es": "Con excepciones documentadas.",
        "ca": "Amb excepcions documentades."
      },
      "source": {
        "url": "https://cursor.com/docs/agent/security.md",
        "official": true,
        "accessed_at": "2026-10-25"
      }
    }
  ],
  "storage": [
    {
      "id": "sto-mcp-user",
      "kind": "mcp_user",
      "path_windows": "%USERPROFILE%\\.cursor\\mcp.json",
      "secrets": "sometimes_plaintext",
      "note": {
        "en": "MCP env and headers blocks can hold keys.",
        "es": "Los bloques env y headers de MCP pueden contener claves.",
        "ca": "Els blocs env i headers de MCP poden contenir claus."
      },
      "source": {
        "url": "https://github.com/qtorb/rosmarops/blob/v0.3.0/adapters/windows/mcp.go",
        "official": false,
        "accessed_at": "2026-10-28"
      }
    },
    {
      "id": "sto-mcp-project",
      "kind": "mcp_project",
      "path_windows": "<project>\\.cursor\\mcp.json",
      "secrets": "sometimes_plaintext",
      "source": {
        "url": "https://github.com/qtorb/rosmarops/blob/v0.3.0/adapters/windows/mcp.go",
        "official": false,
        "accessed_at": "2026-10-28"
      }
    },
    {
      "id": "sto-permissions",
      "kind": "permissions",
      "path_windows": "%USERPROFILE%\\.cursor\\permissions.json, <project>\\.cursor\\permissions.json",
      "secrets": "none",
      "source": {
        "url": "https://cursor.com/docs/reference/permissions",
        "official": true,
        "accessed_at": "2026-10-28"
      }
    },
    {
      "id": "sto-sandbox",
      "kind": "sandbox",
      "path_windows": "%USERPROFILE%\\.cursor\\sandbox.json, <project>\\.cursor\\sandbox.json",
      "secrets": "none",
      "source": {
        "url": "https://github.com/qtorb/rosmarops/blob/v0.3.0/adapters/windows/cursor.go",
        "official": false,
        "accessed_at": "2026-10-28"
      }
    },
    {
      "id": "sto-cli-config",
      "kind": "cli_config",
      "path_windows": "%USERPROFILE%\\.cursor\\cli-config.json",
      "secrets": "unknown",
      "source": {
        "url": "https://github.com/qtorb/rosmarops/blob/v0.3.0/adapters/windows/cursor.go",
        "official": false,
        "accessed_at": "2026-10-28"
      }
    },
    {
      "id": "sto-hooks-managed",
      "kind": "hooks_managed",
      "path_windows": "C:\\ProgramData\\Cursor\\hooks.json",
      "secrets": "none",
      "source": {
        "url": "https://github.com/qtorb/rosmarops/blob/v0.3.0/adapters/windows/cursor.go",
        "official": false,
        "accessed_at": "2026-10-28"
      }
    }
  ]
}

      "versions": [],
      "changes": [
        {
          "id": "chg-copilot-projects-multi-repo",
          "date": "2026-10-28",
          "category": "agent_scope",
          "before": {
            "en": "No announced way to run one Copilot agent task across several repositories at once.",
            "es": "No se había anunciado ninguna forma de ejecutar una misma tarea de un agente de Copilot en varios repositorios a la vez.",
            "ca": "No s'havia anunciat cap manera d'executar una mateixa tasca d'un agent de Copilot en diversos repositoris alhora."
          },
          "after": {
            "en": "Copilot projects run agent work across several repositories in parallel sessions, in the GitHub Copilot app, available from 28 October 2026.",
            "es": "Los proyectos de Copilot ejecutan trabajo de agentes en varios repositorios en sesiones paralelas, en la aplicación GitHub Copilot, disponible desde el 28 de octubre de 2026.",
            "ca": "Els projectes de Copilot executen feina d'agents en diversos repositoris en sessions paral·leles, a l'aplicació GitHub Copilot, disponible des del 28 d'octubre de 2026."
          },
          "source": {
            "url": "https://github.blog/news-insights/company-news/github-universe-2026-evolving-every-layer-of-the-stack/",
            "official": true,
            "accessed_at": "2026-10-28"
          },
          "verified": {
            "by": "advisor",
            "at": "2026-10-28",
            "how": "official_changelog"
          },
          "rosmarops_impact": "knowledge"
        },
        {
          "id": "chg-copilot-session-continuity",
          "date": "2026-10-28",
          "category": "data_destination",
          "before": {
            "en": "No announced way to follow one cloud agent session from several places.",
            "es": "No se había anunciado ninguna forma de seguir una misma sesión de agente en la nube desde varios sitios.",
            "ca": "No s'havia anunciat cap manera de seguir una mateixa sessió d'agent al núvol des de diversos llocs."
          },
          "after": {
            "en": "The same cloud agent session can be started and followed from the GitHub app, VS Code, the CLI and the web. The session runs in GitHub's cloud. Availability not stated.",
            "es": "La misma sesión de agente en la nube se puede iniciar y seguir desde la aplicación de GitHub, VS Code, la línea de órdenes y la web. La sesión se ejecuta en la nube de GitHub. No se indica disponibilidad.",
            "ca": "La mateixa sessió d'agent al núvol es pot iniciar i seguir des de l'aplicació de GitHub, VS Code, la línia d'ordres i el web. La sessió s'executa al núvol de GitHub. No se n'indica la disponibilitat."
          },
          "source": {
            "url": "https://github.blog/news-insights/company-news/github-universe-2026-evolving-every-layer-of-the-stack/",
            "official": true,
            "accessed_at": "2026-10-28"
          },
          "verified": {
            "by": "advisor",
            "at": "2026-10-28",
            "how": "official_changelog"
          },
          "rosmarops_impact": "none"
        },
        {
          "id": "chg-copilot-automations-propose-changes",
          "date": "2026-10-28",
          "category": "instructions",
          "before": {
            "en": "No announced way for Copilot automations to propose changes to themselves.",
            "es": "No se había anunciado ninguna forma de que las automatizaciones de Copilot propusieran cambios sobre sí mismas.",
            "ca": "No s'havia anunciat cap manera que les automatitzacions de Copilot proposessin canvis sobre si mateixes."
          },
